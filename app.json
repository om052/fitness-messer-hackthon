{
  "expo": {
    "name": "Fitness Messer",
    "slug": "fitness-messer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "scheme": "fitnessmesser",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitnessmesser.app"
    },
    "android": {
      "package": "com.fitnessmesser.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
